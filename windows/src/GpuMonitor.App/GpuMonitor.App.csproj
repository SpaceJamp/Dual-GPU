<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GpuMonitor</AssemblyName>
    <RootNamespace>GpuMonitor.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <Compile Remove="Platform/Windows/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0-windows10.0.19041.0'">
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../GpuMonitor.Core/GpuMonitor.Core.csproj" />
    <InternalsVisibleTo Include="GpuMonitor.App.Tests" />
  </ItemGroup>
</Project>
