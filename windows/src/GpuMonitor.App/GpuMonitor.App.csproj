<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GpuMonitor</AssemblyName>
    <RootNamespace>GpuMonitor.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows10.0.19041.0'">
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_IsPublishing)'=='true' And '$(TargetFramework)'=='net10.0-windows10.0.19041.0'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- System.Management uses COM interop, which trimming otherwise turns off. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The report and settings use reflection-based JSON; publishing would otherwise turn that off. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- TrimMode partial leaves GpuMonitor.Core untrimmed, so its JSON reflection keeps its types. Checked on the published exe. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL3050</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <Compile Remove="Platform/Windows/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0-windows10.0.19041.0'">
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.14" />
    <!-- System.Management creates its COM wrappers by reflection, so trimming must not touch it. -->
    <TrimmerRootAssembly Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/icon.png;Assets/icon.ico" />
    <Content Include="Assets/icon.png;Assets/icon.ico" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../GpuMonitor.Core/GpuMonitor.Core.csproj" />
    <InternalsVisibleTo Include="GpuMonitor.App.Tests" />
  </ItemGroup>
</Project>
