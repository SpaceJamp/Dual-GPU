<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'!='net10.0-windows10.0.19041.0'">
    <Compile Remove="Windows/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/GpuMonitor.App/GpuMonitor.App.csproj" />
    <Compile Include="../GpuMonitor.Core.Tests/FakeNvml.cs" Link="FakeNvml.cs" />
  </ItemGroup>
</Project>
